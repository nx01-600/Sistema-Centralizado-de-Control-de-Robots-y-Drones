generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dispositivo {
  id              String     @id @default(uuid())
  nombre          String
  tipo            TipoDispositivo
  identificador   String     @unique
  ubicacion       String
  nivelBateria    Int        @default(100)
  estado          EstadoDispositivo @default(DISPONIBLE)
  
  reservas        Reserva[]
  metricas        Metrica[]
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("dispositivos")
}

model Reserva {
  id                String    @id @default(uuid())
  dispositivoId     String
  dispositivo       Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  
  fechaSalida       DateTime
  horaSalida        String
  fechaRegreso      DateTime
  horaRegreso       String
  
  solicitadoPor     String
  tipoServicio      TipoServicio
  ubicacionOrigen   String?
  ubicacionDestino  String?
  observaciones     String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("reservas")
}

model Metrica {
  id                String      @id @default(uuid())
  dispositivoId     String
  dispositivo       Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  
  temperatura       Float?
  humedad           Float?
  velocidad         Float?
  altitud           Float?
  
  tiempoVuelo       Int
  horasTotales      Float       @default(0)
  distanciaTotal    Float       @default(0)
  
  fecha             DateTime    @default(now())
  
  @@map("metricas")
}

enum TipoDispositivo {
  ROBOT
  DRONE
}

enum EstadoDispositivo {
  DISPONIBLE
  EN_USO
  EN_MANTENIMIENTO
  EN_CARGA
}

enum TipoServicio {
  TRANSPORTE_INTERNO
  GRABACION_EVENTO
  MONITOREO
  ENTREGA
}
